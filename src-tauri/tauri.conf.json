{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Habit Sumaq",
  "version": "0.3.0",
  "identifier": "com.habitsumaq.app",
  "build": {
    "frontendDist": "https://habit-sumaq-web.vercel.app",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "windows": [
      {
        "title": "Habit Sumaq",
        "width": 1280,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
